                <th>Volumen producido</th>

                <th>Fin</th>

                <th>Inicio F2</th>

                <th width="320">

                    Acciones

                </th>

            </tr>

        </thead>

        <tbody id="batchesTableBody">

        </tbody>

    </table>

</div>

