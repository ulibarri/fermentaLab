<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1>Lotes de producción</h1>

            <small class="text-muted">

                Seguimiento de lotes FermentaLab

            </small>

        </div>

        <div>

            <a href="/maturation/statistics" class="btn btn-outline-secondary me-2">

                Precisión histórica

            </a>

            <button id="btnNuevo" class="btn btn-primary">

                Nuevo Lote

            </button>

        </div>

    </div>

    <div id="loader" class="alert alert-info" style="display:none">

