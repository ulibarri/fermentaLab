<div class="modal fade" id="modalF2Finish" tabindex="-1" aria-labelledby="modalF2FinishTitle" aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form id="f2FinishForm">

                <div class="modal-header">

                    <h5 class="modal-title" id="modalF2FinishTitle">
                        Finalizar segunda fermentación
                    </h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="mb-3">

                        <label for="finalPsiReading" class="form-label">
                            Presión final (PSI)
                        </label>

                        <input type="number" step="0.001" id="finalPsiReading" name="finalPsiReading" class="form-control">

                    </div>

                    <div class="mb-3">

                        <label for="finalPh" class="form-label">
                            pH final
                        </label>

                        <input type="number" step="0.01" id="finalPh" name="finalPh" class="form-control">

                    </div>

                    <div class="mb-3">

                        <label for="finalBrix" class="form-label">
                            °Brix final
                        </label>

                        <input type="number" step="0.01" id="finalBrix" name="finalBrix" class="form-control">

                    </div>

                    <div class="mb-3">

                        <label for="finalSpecificGravity" class="form-label">
                            SG final
                        </label>

                        <input type="number" step="0.0001" id="finalSpecificGravity" name="finalSpecificGravity" class="form-control">

                    </div>

                    <div class="mb-3">

                        <label for="estimatedAlcohol" class="form-label">
                            Alcohol estimado (%)
                        </label>

                        <input type="number" step="0.01" id="estimatedAlcohol" name="estimatedAlcohol" class="form-control">

                    </div>

                    <div class="mb-3">

                        <label for="finalTemperature" class="form-label">
                            Temperatura del producto (°C)
                        </label>

                        <input type="number" step="0.01" id="finalTemperature" name="finalTemperature" class="form-control">

                    </div>

                    <div class="mb-3">

                        <label for="ambientTemperature" class="form-label">
                            Temperatura ambiente (°C)
                        </label>

                        <input type="number" step="0.01" id="ambientTemperature" name="ambientTemperature" class="form-control">

                    </div>

                    <div class="mb-3">

                        <label for="carbonationNotes" class="form-label">
                            Observaciones de carbonatación
                        </label>

                        <textarea id="carbonationNotes" name="carbonationNotes" class="form-control" rows="3">
                        </textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="submit" class="btn btn-success">

                        Finalizar F2

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
