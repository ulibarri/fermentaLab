<div class="modal fade" id="modalMeasurement" tabindex="-1" aria-labelledby="modalMeasurementTitle" aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form id="measurementForm">

                <div class="modal-header">

                    <h5 class="modal-title" id="modalMeasurementTitle">
                        Nueva Medición
                    </h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="mb-3">

                        <label for="measurementDate" class="form-label">
                            Fecha y hora
                        </label>

                        <input type="datetime-local" id="measurementDate" name="measurementDate" class="form-control" required>

                    </div>

                    <div class="mb-3">

                        <label for="phase" class="form-label">
                            Fase
                        </label>

                        <select id="phase" name="phase" class="form-select" required>

                            <option value="F1">F1</option>

                            <option value="F2">F2</option>

                            <option value="FINAL">FINAL</option>

                        </select>

                    </div>

                    <div id="f1FinalFieldsGroup">

                        <!-- Entrega 2.8.0.3, sección 4 -- "Hidrómetro" y "Brixómetro"
                             deben quedar claramente separados en la interfaz: el primero
                             estima SG/Brix/Alcohol (a mano o vía conversión); el segundo
                             es la lectura DIRECTA e independiente de un instrumento
                             distinto. Nunca se reemplaza uno por otro. -->
                        <div class="card mb-3">

                            <div class="card-header">
                                Hidrómetro
                                <small class="text-muted d-block">SG, °Brix estimado y % Alcohol -- manual o calculado a partir de una sola lectura.</small>
                            </div>

                            <div class="card-body">

                        <!-- Entrega 2.8.0.1, sección 2 -- dos modos de captura de las lecturas del hidrómetro. -->
                        <div class="mb-3">

                            <label class="form-label d-block">
                                ¿Cómo deseas registrar las lecturas del hidrómetro?
                            </label>

                            <div class="form-check form-check-inline">

                                <input class="form-check-input" type="radio" name="hydrometerMode" id="hydrometerModeManual" value="MANUAL" checked>

                                <label class="form-check-label" for="hydrometerModeManual">
                                    Ingresar manualmente las tres lecturas
                                </label>

                            </div>

                            <div class="form-check form-check-inline">

                                <input class="form-check-input" type="radio" name="hydrometerMode" id="hydrometerModeAuto" value="AUTO">

                                <label class="form-check-label" for="hydrometerModeAuto">
                                    Calcular automáticamente a partir de una lectura
                                </label>

                            </div>

                        </div>

                        <!-- Sección 15/16 -- panel de conversión automática, resultado revisable antes de aplicar. -->
                        <div id="hydrometerAutoPanel" class="card mb-3" style="display:none">

                            <div class="card-body">

                                <div class="row gy-2 align-items-end">

                                    <div class="col-4">
                                        <label for="hydrometerScale" class="form-label mb-1">Escala utilizada</label>
                                        <select id="hydrometerScale" class="form-select">

                                            <option value="SG">SG</option>

                                            <option value="BRIX">Brix</option>

                                            <option value="ALCOHOL">% Alcohol</option>

                                        </select>
                                    </div>

                                    <div class="col-4">
                                        <label for="hydrometerValue" class="form-label mb-1">Valor leído</label>
                                        <input type="number" step="any" id="hydrometerValue" class="form-control">
                                    </div>

                                    <div class="col-4">
                                        <button type="button" class="btn btn-outline-primary w-100" id="btnHydrometerCalculate">
                                            Calcular
                                        </button>
                                    </div>

                                </div>

                                <!-- Entrega 2.8.0.2, sección 18 -- desde esta entrega, el resultado
                                     de "Calcular" sale de la tabla ACTIVE en Configuración → Hidrómetros
                                     → Tabla de conversión, no de una tabla embebida en el código. -->
                                <div class="text-end mt-2">
                                    <a href="/hydrometer/conversion-tables" target="_blank" class="small">
                                        Administrar tabla de conversión
                                    </a>
                                </div>

                                <div id="hydrometerError" class="alert alert-danger small mt-3 mb-0" style="display:none">
                                </div>

                                <div id="hydrometerResult" class="mt-3" style="display:none">

                                    <table class="table table-sm mb-2">

                                        <tbody>

                                            <tr>
                                                <th style="width:30%">SG</th>
                                                <td id="hydrometerResultSg">—</td>
                                            </tr>

                                            <tr>
                                                <th>Brix</th>
                                                <td id="hydrometerResultBrix">—</td>
                                            </tr>

                                            <tr>
                                                <th>% Alcohol</th>
                                                <td id="hydrometerResultAlcohol">—</td>
                                            </tr>

                                        </tbody>

                                    </table>

                                    <div class="small text-muted" id="hydrometerResultMethod">
                                        —
                                    </div>

                                    <div class="mt-2">

                                        <button type="button" class="btn btn-sm btn-secondary" id="btnHydrometerCancelResult">
                                            Cancelar
                                        </button>

                                        <button type="button" class="btn btn-sm btn-success" id="btnHydrometerUseValues">
                                            Usar estos valores
                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-4 mb-3">

                                <label for="specificGravity" class="form-label">
                                    SG
                                    <span id="specificGravityHydrometerBadge" class="badge bg-secondary" style="display:none" tabindex="0"></span>
                                </label>

                                <input type="number" step="0.0001" id="specificGravity" name="specificGravity" class="form-control">

                            </div>

                            <div class="col-4 mb-3">

                                <label for="brix" class="form-label">
                                    °Brix estimado
                                    <span id="brixHydrometerBadge" class="badge bg-secondary" style="display:none" tabindex="0"></span>
                                </label>

                                <input type="number" step="0.01" id="brix" name="brix" class="form-control">

                            </div>

                            <div class="col-4 mb-3">

                                <label for="estimatedAlcohol" class="form-label">
                                    % Alcohol
                                    <span id="estimatedAlcoholHydrometerBadge" class="badge bg-secondary" style="display:none" tabindex="0"></span>
                                </label>

                                <input type="number" step="0.01" id="estimatedAlcohol" name="estimatedAlcohol" class="form-control">

                            </div>

                        </div>

                        <!-- Entrega 2.8.0.3, sección 6/8 -- detalle de trazabilidad de la
                             última conversión aplicada a ESTA medición (visible en cuanto hay
                             una escala/valor de origen guardados, sea porque se acaba de
                             calcular o porque se está editando una medición ya calculada). -->
                        <div id="hydrometerTraceabilityDetail" class="small text-muted" style="display:none">
                        </div>

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-6 mb-3">

                                <label for="ph" class="form-label">
                                    pH
                                </label>

                                <input type="number" step="0.01" id="ph" name="ph" class="form-control">

                            </div>

                            <div class="col-6 mb-3">

                                <label for="liquidTemperature" class="form-label">
                                    Temp. líquido (°C)
                                </label>

                                <input type="number" step="0.01" id="liquidTemperature" name="liquidTemperature" class="form-control">

                            </div>

                        </div>

                        <div class="card mb-3">

                            <div class="card-header">
                                Brixómetro
                                <small class="text-muted d-block">Brix MEDIDO directamente por el instrumento -- independiente del hidrómetro, nunca se deriva ni se reemplaza por el Brix estimado.</small>
                            </div>

                            <div class="card-body">

                                <div class="mb-0">

                                    <label for="brixLafmate" class="form-label">
                                        Brix LAFmate (real)
                                    </label>

                                    <input type="number" step="0.01" id="brixLafmate" name="brixLafmate" class="form-control">

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label for="ambientTemperature" class="form-label">
                            Temp. ambiente (°C)
                        </label>

                        <input type="number" step="0.01" id="ambientTemperature" name="ambientTemperature" class="form-control">

                    </div>

                    <div class="mb-3" id="psiGroup">

                        <label for="psi" class="form-label">
                            PSI
                        </label>

                        <input type="number" step="0.001" id="psi" name="psi" class="form-control">

                        <small class="form-text text-muted">
                            Solo aplica en la fase F2 (F1 es aeróbica).
                        </small>

                    </div>

                    <div class="mb-3" id="co2Group">

                        <label class="form-label">
                            CO2 estimado (volumes)
                        </label>

                        <div class="form-control-plaintext fw-bold" id="co2PreviewValue">
                            —
                        </div>

                        <small class="form-text text-muted">
                            Calculado automáticamente a partir de PSI y temperatura ambiente. No se captura manualmente.
                        </small>

                    </div>

                    <!-- Entrega 2.8.0.1, sección 10 -- trazabilidad de la conversión, nunca editados directamente por el operador. -->
                    <input type="hidden" id="hydrometerInputScale" name="hydrometerInputScale">
                    <input type="hidden" id="hydrometerInputValue" name="hydrometerInputValue">
                    <input type="hidden" id="hydrometerConversionMethod" name="hydrometerConversionMethod">

                    <div class="mb-3">

                        <label for="notes" class="form-label">
                            Notas
                        </label>

                        <textarea id="notes" name="notes" class="form-control" rows="2">
                        </textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="submit" class="btn btn-success">

                        Guardar

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
